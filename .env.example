# Default: fully offline, no keys needed.
REDLINE_BACKEND=offline
REDLINE_MIN_TYPE_CONFIDENCE=0.45

# Optional LLM backend (OpenAI-compatible). Set REDLINE_BACKEND=llm to enable.
# REDLINE_LLM_PROVIDER=openai          # or: azure
# REDLINE_LLM_BASE_URL=https://api.openai.com/v1
# REDLINE_LLM_API_KEY=
# REDLINE_LLM_MODEL=gpt-4o-mini        # for azure: the deployment name
# REDLINE_AZURE_API_VERSION=2024-06-01
